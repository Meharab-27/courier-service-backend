model Hub {
  id                   String     @id @default(uuid())
  name                 String     @db.VarChar(150)
  code                 String     @unique @db.VarChar(20) // e.g. "HUB-KHU-01", "HUB-DHK-01"
  address              String     @db.Text
  zone                 String     @db.VarChar(100)        // e.g. "Khulna Division", "Dhaka Metro"
  contactNo            String     @db.VarChar(20)
  latitude             Float?
  longitude            Float?

  // সফট ডিলিটের জন্য
  deletedAt            DateTime?

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

// originShipments      Shipment[] @relation("OriginHubShipments")
//   destinationShipments Shipment[] @relation("DestinationHubShipments")

  @@index([code, zone])
  @@index([deletedAt])
  @@map("hubs")
}